# LaTeX build output
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.pdf
*.synctex.gz
*.toc
*.dgm
*.exr
*.xdv

# Rendered diagrams are build output. The .mmd source is the committed
# artefact, so diagram changes review as text.
figures/diagrams/

# NOTE: figures/values/ and figures/transcripts/ are deliberately NOT ignored.
# The generated numbers and transcripts are committed, because committing them
# is what makes a change to a printed number show up in review as a diff, and
# what lets CI fail the build when a script no longer produces what the book
# prints. They are build output that is also evidence.

# mermaid-cli browser path is machine-specific
figures/mermaid/.puppeteer.json
.puppeteer.json

# Python (code/ is a uv project; uv.lock IS committed)
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# coverage's data file. The REPORT is a committed transcript under
# figures/transcripts/; the binary it is computed from is not.
.coverage
.pytest_cache/
.hypothesis/
dist/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Locally assembled Pages site (make site)
_site/

# The values index is regenerated by `make numbers` and by CI; the values
# themselves are committed and drift-gated.
figures/values/all.tex

# E7 assembles a throwaway Docker build context here.
build/
