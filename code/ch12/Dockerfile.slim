# Shape two: the slim base and uv, in one stage. Better, and still
# shipping the tool that did the installing.
#
# uv is copied in from its own published image rather than installed with
# pip, which is the pattern astral document. --frozen installs exactly
# what uv.lock says and does not re-resolve; --no-dev leaves the test and
# lint dependencies behind. Both matter more than the base image does.
FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src src
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"
CMD ["python", "-m", "ops"]
